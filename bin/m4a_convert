#!/usr/bin/env bash
#
#	m4a_convert 1.0
#	Description: Convert every m4a file in a folder (and its subfolders) to
#	             mp3 at full quality, keeping tags and cover art.
#	Author: Angelos Michalopoulos
#	Last Updated: 18/08/2026
#
#	Argument List:
#
#	[folder]		Folder to scan (Default: Current Directory)
#	[-d]			Delete the original m4a after a successful conversion
#	[-f]			Overwrite an already existing mp3
#	[-h]			Help Screen
#

VERSION='1.0'

C0='\033[m'			# System Default Color
C1='\033[2;38m'		# Light, Dark Green
C2='\033[3;37m'		# Regular, White
C3='\033[1;33m'		# Bold, Yellow
C4='\033[1;31m'		# Bold, Red
C5='\033[1;36m'		# Bold, Cyan

# Defaults
BITRATE='320k'
FOLDER="$PWD"
DELETE=0
FORCE=0

usage() {
	echo -e "${C3}m4a_convert ${VERSION}${C0}"
	echo -e "${C2}Convert every m4a file in a folder tree to mp3 (${BITRATE}).${C0}\n"
	echo -e "${C3}Usage:${C0} m4a_convert [-d] [-f] [folder]\n"
	echo -e "  -d  Delete the original m4a after a successful conversion"
	echo -e "  -f  Overwrite an already existing mp3"
	echo -e "  -h  This help screen"
}

error() {
	echo -e "${C4}Error:${C0} $1" >&2
}

convert_m4a() {
	local src="$1" dst="$2"

	# Keep the embedded cover art when ffmpeg can carry it over
	ffmpeg -v error -y -i "$src" \
		-map 0:a:0 -map '0:v:0?' \
		-c:a libmp3lame -b:a "$BITRATE" \
		-c:v copy -disposition:v:0 attached_pic \
		-map_metadata 0 -id3v2_version 3 \
		"$dst" 2>/dev/null && return 0

	ffmpeg -v error -y -i "$src" \
		-map 0:a:0 -vn \
		-c:a libmp3lame -b:a "$BITRATE" \
		-map_metadata 0 -id3v2_version 3 \
		"$dst"
}

# Arguments
FOLDER_SET=0
while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help)	usage; exit 0 ;;
		-d)			DELETE=1 ;;
		-f)			FORCE=1 ;;
		-*)			error "Unknown option '$1'"; usage; exit 1 ;;
		*)
			if [ "$FOLDER_SET" -eq 0 ]; then
				FOLDER="$1"
				FOLDER_SET=1
			else
				error "Too many arguments"
				usage
				exit 1
			fi
			;;
	esac
	shift
done

if [ ! -d "$FOLDER" ]; then
	error "Folder '$FOLDER' does not exist"
	exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
	error "ffmpeg is not installed"
	exit 1
fi

FOLDER=$(cd "$FOLDER" && pwd)

# Collect every m4a in the tree
FILES=()
while IFS= read -r -d '' file; do
	FILES+=("$file")
done < <(find "$FOLDER" -type f -iname '*.m4a' -print0 | sort -z)

TOTAL=${#FILES[@]}

if [ "$TOTAL" -eq 0 ]; then
	echo -e "${C3}No m4a files found in '${FOLDER}'${C0}"
	exit 0
fi

echo -e "${C1}${TOTAL} m4a files${C0} -> ${C5}${FOLDER}${C0}\n"

CONVERTED=0
SKIPPED=0
FAILED=0

for file in "${FILES[@]}"; do
	target="${file%.*}.mp3"
	label="${file#$FOLDER/}"

	echo -en "${C2}${label}${C0} "

	if [ -f "$target" ] && [ "$FORCE" -eq 0 ]; then
		SKIPPED=$((SKIPPED + 1))
		echo -e "[${C3} SKIP ${C0}]"
		continue
	fi

	if convert_m4a "$file" "$target"; then
		CONVERTED=$((CONVERTED + 1))
		[ "$DELETE" -eq 1 ] && rm -f "$file"
		echo -e "[${C5} OK ${C0}]"
	else
		FAILED=$((FAILED + 1))
		rm -f "$target"
		echo -e "[${C4} FAIL ${C0}]"
	fi
done

echo -e "\n${C1}Converted: ${CONVERTED}${C0}"
[ "$SKIPPED" -gt 0 ] && echo -e "${C3}Skipped: ${SKIPPED}${C0}"
[ "$FAILED" -gt 0 ] && echo -e "${C4}Failed: ${FAILED}${C0}"

exit 0
